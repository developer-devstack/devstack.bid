{
  // User-site router: *.devstack.bid → AWS S3 static + WfP dispatcher for SSR.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "devstack-sites",
  "main": "index.ts",
  "compatibility_date": "2026-10-06",
  // Legacy workers.dev proxy path needs public fetch; WfP dispatch stays in-process.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "*.devstack.bid/*", "zone_name": "devstack.bid" }],
  "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "devstack-sites" }],
  "vars": { "PLATFORM_DOMAIN": "devstack.bid", "WORKERS_SUBDOMAIN": "examplessdk", "AWS_S3_BUCKET": "amazon-sagemaker-313313524777-eu-north-1-40y3fau5lyj53n", "AWS_S3_REGION": "eu-north-1" },
  "observability": { "enabled": true }
}
