{
  // User-site router: *.devstack.bid → R2 static + WfP dispatcher for SSR.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "devstack-sites",
  "main": "index.ts",
  "compatibility_date": "2026-10-06",
  // Legacy workers.dev proxy path needs public fetch; WfP dispatch stays in-process.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "*.devstack.bid/*", "zone_name": "devstack.bid" }],
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "devstack-sites" }],
  "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "devstack-sites" }],
  "vars": { "PLATFORM_DOMAIN": "devstack.bid", "WORKERS_SUBDOMAIN": "examplessdk" },
  "observability": { "enabled": true }
}
